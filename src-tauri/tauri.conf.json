{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexam",
  "version": "0.14.0",
  "identifier": "com.nexam.desktop",
  "build": {
    "beforeDevCommand": "cd app/frontend && npm run dev",
    "beforeBuildCommand": "cd app/frontend && npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../app/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexam",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "resources": {
      "../dist/backend/nexam-backend": "nexam-backend",
      "../samples/demo-bank.bok": "samples/demo-bank.bok",
      "../samples/demo-gradebook.nxgb": "samples/demo-gradebook.nxgb"
    }
  }
}
