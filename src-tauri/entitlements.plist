<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Hardened runtime is required for notarization. The frozen Python
	backend (dist/backend/nexam-backend, built by PyInstaller) loads a
	large number of its own bundled .so/.dylib files at runtime; even
	though the release workflow signs every one of them with this same
	Developer ID identity, PyInstaller's own notarization guidance calls
	out library validation as the check most likely to reject a frozen
	Python executable anyway. If a signed, notarized build fails to
	launch (rather than failing notarization itself), this is the first
	entitlement to suspect.
	-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
